rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      function isOwner() {
        return isSignedIn() && request.auth.uid == userId;
      }

      allow get: if isOwner() || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner()
        && request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'role', 'photoURL', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'role', 'photoURL', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.photoURL is string;

      allow update: if (
          isOwner()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'photoURL', 'updatedAt'])
        ) || (
          isAdmin()
          && userId != request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.role in ['user', 'admin']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['role', 'updatedAt'])
        );

      allow delete: if false;
    }

    match /scores/{scoreId} {
      function validScore(data) {
        return data.keys().hasAll([
            'title', 'composer', 'category', 'details', 'price',
            'driveFileId', 'driveUrl', 'createdAt', 'updatedAt', 'createdBy'
          ])
          && data.keys().hasOnly([
            'title', 'composer', 'category', 'details', 'price',
            'driveFileId', 'driveUrl', 'createdAt', 'updatedAt', 'createdBy'
          ])
          && data.title is string
          && data.title.size() > 0
          && data.composer is string
          && data.category is string
          && data.details is string
          && (data.price == null || data.price is number)
          && data.driveFileId is string
          && data.driveFileId.size() > 0
          && data.driveUrl is string
          && data.driveUrl.matches('https://drive\\.google\\.com/.*')
          && data.createdBy is string;
      }

      allow read: if true;
      allow create: if isAdmin()
        && validScore(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && validScore(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    match /licenseRequests/{requestId} {
      allow get, list: if isAdmin();

      allow create: if request.resource.data.keys().hasAll([
          'scoreId', 'scoreTitle', 'requesterName', 'requesterEmail',
          'requesterUid', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'scoreId', 'scoreTitle', 'requesterName', 'requesterEmail',
          'requesterUid', 'status', 'createdAt'
        ])
        && request.resource.data.scoreId is string
        && request.resource.data.scoreId.size() > 0
        && exists(/databases/$(database)/documents/scores/$(request.resource.data.scoreId))
        && request.resource.data.scoreTitle
          == get(/databases/$(database)/documents/scores/$(request.resource.data.scoreId)).data.title
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() > 0
        && request.resource.data.requesterName.size() <= 100
        && request.resource.data.requesterEmail is string
        && request.resource.data.requesterEmail.size() > 3
        && request.resource.data.requesterEmail.size() <= 254
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (
          (request.auth == null && request.resource.data.requesterUid == '')
          || (
            request.auth != null
            && request.resource.data.requesterUid == request.auth.uid
            && request.resource.data.requesterEmail == request.auth.token.email
          )
        );

      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'issuedAt', 'licenseTitle', 'licensedTo'])
        && (
          (
            request.resource.data.status == 'approved'
            && request.resource.data.issuedAt is timestamp
            && request.resource.data.licenseTitle is string
            && request.resource.data.licenseTitle.size() > 0
            && request.resource.data.licenseTitle.size() <= 160
            && request.resource.data.licensedTo is string
            && request.resource.data.licensedTo.size() > 0
            && request.resource.data.licensedTo.size() <= 100
          )
          || (
            request.resource.data.status == 'declined'
            && !request.resource.data.keys().hasAny(['issuedAt'])
            && !request.resource.data.keys().hasAny(['licenseTitle', 'licensedTo'])
          )
        );
      allow delete: if false;
    }
  }
}
